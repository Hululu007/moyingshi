<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application>

        <activity-alias
            android:name=".ui.activity.HomeActivityCurrent"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".flutter.C1ScreenActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ui.activity.HomeActivityHistory"
            android:enabled="false"
            android:exported="true"
            android:icon="@drawable/ic_launcher_history"
            android:label="@string/app_name"
            android:roundIcon="@drawable/ic_launcher_history"
            android:targetActivity=".flutter.C1ScreenActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- B8 delete-native phase 3: the launcher home. The launcher
             aliases target this Activity; the SEARCH/SEND/VIEW
             intent-filters and the searchable meta-data moved here
             verbatim from .ui.activity.HomeActivity (see
             docs/b8-delete-native-plan.md §3). configChanges keeps the
             existing keyboard/uiMode set and adds the orientation family
             copied from the native rotation-stable activities, so
             rotation never recreates the home (D4). -->
        <activity
            android:name=".flutter.C1ScreenActivity"
            android:configChanges="keyboard|keyboardHidden|uiMode|screenSize|smallestScreenSize|screenLayout|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEARCH" />
            </intent-filter>
            <meta-data
                android:name="android.app.searchable"
                android:resource="@xml/searchable" />
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-bittorrent" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="smb" />
                <data android:scheme="rtmp" />
                <data android:scheme="rtsp" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="ed2k" />
                <data android:scheme="magnet" />
                <data android:scheme="thunder" />
                <data android:scheme="jianpian" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.AppBrandingActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.PluginManagerActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.hk.HkListActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:parentActivityName=".lab.LabActivity"
            android:screenOrientation="fullUser">
            <intent-filter>
                <action android:name="${applicationId}.hk_list" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.hk.HkDetailActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:parentActivityName=".ui.hk.HkListActivity"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.hk.HkSearchActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:parentActivityName=".ui.hk.HkListActivity"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.LocalSourceDialogActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:parentActivityName=".lab.LabActivity"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.App.Lab.LocalSourceDialogHost">
            <intent-filter>
                <action android:name="${applicationId}.local_source_dialog" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.ViewingReportActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.ShortDramaActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="false"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.activity.LiveActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="true"
            android:launchMode="singleTop"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.ScanActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.VideoActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:launchMode="singleTop"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.TmdbDetailActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser"
            android:supportsPictureInPicture="true" />

        <activity
            android:name=".ui.activity.WebThemeDetailActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="false"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.WebHomeShellActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:exported="false"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.TmdbPersonActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser" />

        <activity
            android:name=".ui.activity.AudioActivity"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|uiMode|orientation"
            android:parentActivityName=".flutter.C1ScreenActivity"
            android:screenOrientation="fullUser" />

        <receiver
            android:name=".receiver.ShortcutReceiver"
            android:exported="false" />

        <service
            android:name=".service.DLNACastService"
            android:exported="false" />

    </application>
</manifest>
