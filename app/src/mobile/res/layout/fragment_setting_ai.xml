<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:backgroundBlurRadius="16dp"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIconTint="@android:color/white"
        app:title="@string/setting_ai"
        app:titleTextAppearance="@style/ToolbarTextAppearance" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">





            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="4dp" android:text="@string/setting_ai_group_recommendation" android:textColor="?attr/webhtvColorOnWallpaper" android:textSize="16sp" android:textStyle="bold" />
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/aiRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_row_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/shape_setting_circle_purple">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_setting_ai"
                        android:tint="@android:color/white" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_ai_recommendation"
                    android:textColor="@color/setting_card_title"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/aiRecommendationText"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/setting_card_value"
                    android:textSize="16sp"
                    tools:text="@string/setting_unconfigured"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/setting_chevron" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/personalRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_row_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/shape_setting_circle_purple">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_setting_personal"
                        android:tint="@android:color/white" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_personal_recommendation"
                    android:textColor="@color/setting_card_title"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/personalRecommendationText"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textColor="@color/setting_card_value"
                    android:textSize="16sp"
                    tools:text="Off"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/setting_chevron" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/recommendationFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_row_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/shape_setting_circle_purple">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_setting_edit"
                        android:tint="@android:color/white" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_recommendation_feedback"
                    android:textColor="@color/setting_card_title"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/recommendationFeedbackText"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/setting_card_value"
                    android:textSize="16sp"
                    tools:text="2 项 · 90 天后自动恢复" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/setting_chevron" />
            </androidx.appcompat.widget.LinearLayoutCompat>





















            <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="4dp" android:text="@string/setting_ai_group_subtitle" android:textColor="?attr/webhtvColorOnWallpaper" android:textSize="16sp" android:textStyle="bold" />
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/subtitleRealtimeModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/shape_setting_row_card"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/shape_setting_circle_blue">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_setting_subtitle"
                        android:tint="@android:color/white" />
                </FrameLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_height="wrap_content"
                    android:text="@string/player_subtitle_realtime_model"
                    android:textColor="@color/setting_card_title"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/subtitleRealtimeModelText"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:singleLine="true"
                    android:textColor="@color/setting_card_value"
                    android:textSize="16sp"
                    tools:text="未下载（点击下载）" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/setting_chevron" />
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/subtitleAiSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/subtitleAiMaxConcurrency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_setting_row_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/shape_setting_circle_orange">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_setting_number"
                            android:tint="@android:color/white" />
                    </FrameLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:layout_height="wrap_content"
                        android:text="@string/player_subtitle_ai_max_concurrency"
                        android:textColor="@color/setting_card_title"
                        android:textSize="16sp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/subtitleAiMaxConcurrencyText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/setting_card_value"
                        android:textSize="16sp"
                        tools:text="2"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/setting_chevron" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/subtitleAiChunkCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_setting_row_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/shape_setting_circle_orange">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_setting_number"
                            android:tint="@android:color/white" />
                    </FrameLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:layout_height="wrap_content"
                        android:text="@string/player_subtitle_ai_chunk_count"
                        android:textColor="@color/setting_card_title"
                        android:textSize="16sp"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/subtitleAiChunkCountText"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/setting_card_value"
                        android:textSize="16sp"
                        tools:text="2"
                        android:ellipsize="end"
                        android:maxLines="1" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/setting_chevron" />
                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
