<?xml version="1.0" encoding="utf-8"?>
<!-- 首页浏览面板（全部分类 + 筛选合成一个）：上半是分类 chips（与旧 TypeDialog 同款），
     中间分隔线 + “筛选”标题，下半是筛选组列表（与旧 FilterDialog 同款）。
     无筛选条件时分隔线/标题/筛选列表全部隐藏，不留空白。 -->
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_dialog_control_glass_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="9dp"
    android:paddingBottom="20dp">

    <com.github.moyingshi.osc.tv.ui.custom.CustomRecyclerView
        android:id="@+id/typeRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingEnd="7dp"
        tools:listitem="@layout/adapter_type_dialog" />

    <View
        android:id="@+id/filterDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/setting_card_divider"
        android:visibility="gone" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/filterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="@string/home_filter_title"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.github.moyingshi.osc.tv.ui.custom.CustomRecyclerView
        android:id="@+id/filterRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

</androidx.appcompat.widget.LinearLayoutCompat>
