*.patch whitespace=-blank-at-eol,-blank-at-eof
# 从魔影 APK 原样拷来的 drpy 引擎（第三方文件，行尾空格是上游原样，勿改）：跳过空白校验。
quickjs/src/main/assets/js/lib/drpy2-fast.min.js whitespace=-blank-at-eol,-blank-at-eof
quickjs/src/main/assets/js/lib/drpy-core-lite.min.js whitespace=-blank-at-eol,-blank-at-eof
# LUT preset data files: three presets were authored with CRLF line
# endings. A carriage return at end of line is not a whitespace error
# for these data files (values are whitespace-separated), so keep the
# bytes untouched instead of rewriting ~75k LUT lines.
*.cube whitespace=cr-at-eol
